# AgentCenter 云端协调器（DEPLOY_PROFILE=cloud）
# 复制到 /opt/agentcenter/app/.env 后按需填写；不要提交真实密钥。

HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

DEPLOY_PROFILE=cloud
LOCAL_EXECUTOR_SCAN=off
CLOUD_CONNECTOR=off
AI_MOCK_MODE=false

# 控制台进入鉴权。留空则首次启动生成实例口令，写在数据目录 entry_code。
ENTRY_CODE=

# 设备 / fleet-edge / ESP32 / full 握手共用注册令牌；留空则拒绝登记。
FLEET_ENROLL_TOKEN=
FLEET_HEARTBEAT_TTL=45
FLEET_CLOUD_URL=

# 超级AI（OpenAI 兼容）。也可运行时写入 data/super_ai.json。
SUPER_AI_BASE_URL=
SUPER_AI_MODEL=
SUPER_AI_API_KEY=

# 云端不挂本机内容根；保持空，勿填 iCloud / 个人路径。
KNOWLEDGE_WIKI_DIR=
SKILLS_DIR=
HERMES_SKILLS_DIR=
SKILLS_CATALOG_DIR=
OUTPUTS_VAULT_ROOT=
OUTPUTS_VAULT_EXTRA=
KNOWLEDGE_INJECT_ENABLED=false
SKILL_MINE_ENABLED=false

# 相对 SQLite 路径会解析到 AGENTCENTER_DATA_DIR。
DATABASE_URL=sqlite+aiosqlite:///./data/agentcenter.db

# 协调器不跑本机 CLI；保留字段仅为配置完整性。
RUNTIMES=openclaw,hermes
DEFAULT_RUNTIME=openclaw
# cloud profile 下 execution_slots 恒为 0；此值仅作配置完整性保留
MAX_CONCURRENT_TASKS=3
AGENT_SERIAL_EXECUTION=true

CRON_ALERT_ENABLED=false
GATEWAY_ALERT_ENABLED=false
DISK_ALERT_THRESHOLD=90
ALERT_PROFILE=prod
