{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentCenter",
  "version": "0.3.0",
  "identifier": "com.agentcenter.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AgentCenter",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "backgroundColor": "#0b1220"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "resources": {
      "runtime": "runtime"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": false,
      "signingIdentity": "-",
      "dmg": {
        "appPosition": { "x": 160, "y": 180 },
        "applicationFolderPosition": { "x": 420, "y": 180 }
      }
    }
  }
}
