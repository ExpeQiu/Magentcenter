# AgentCenter 配置

# 服务。云端协调器对外监听时改为 0.0.0.0
HOST=127.0.0.1
PORT=8013
FRONTEND_PORT=3013
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./data/agentcenter.db

# 双运行时（逗号分隔）
RUNTIMES=openclaw,hermes
DEFAULT_RUNTIME=openclaw

# OpenClaw
OPENCLAW_EXECUTABLE=openclaw
OPENCLAW_MODE=local
OPENCLAW_GATEWAY_HOST=
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_DEFAULT_TIMEOUT=600
OPENCLAW_MIN_VERSION=2026.5.5

# Hermes
HERMES_EXECUTABLE=hermes
HERMES_HOME=
HERMES_DEFAULT_TIMEOUT=600

# Mock 模式（开发/测试时跳过真实 CLI 调用）
AI_MOCK_MODE=false

# 告警（可选；运行时也可经 /api/settings/alert 热更新，多环境见 alert_profiles.json）
FEISHU_WEBHOOK_URL=
CRON_ALERT_INTERVAL=300
CRON_ALERT_ENABLED=true
GATEWAY_ALERT_ENABLED=true
DISK_ALERT_THRESHOLD=90
ALERT_PROFILE=default

# 知识库向量：hash（默认）| openai | http（OpenAI 兼容 /v1/embeddings）
EMBEDDING_PROVIDER=hash
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# 任务前自动注入知识卡片；完成后蒸馏 Playbook/Precedent/Incident
KNOWLEDGE_INJECT_ENABLED=true
KNOWLEDGE_INJECT_TOP_K=3
# 层权重：L2,L3,L1
KNOWLEDGE_LAYER_WEIGHTS=3.0,1.2,1.0

# 技能目录与自挖掘。控制台可改，改动写在 data/content_roots.json。
# 知识库默认读 iCloud WaytoAI/personalwiki
KNOWLEDGE_WIKI_DIR="/Users/qiubin/Library/Mobile Documents/com~apple~CloudDocs/WaytoAI/personalwiki"
SKILLS_DIR=
HERMES_SKILLS_DIR=
# WaytoAI 技能仓。分类与初始技能都从这里来。
SKILLS_CATALOG_DIR="/Users/qiubin/Library/Mobile Documents/com~apple~CloudDocs/WaytoAI/skills"
SKILL_MINE_ENABLED=true
SKILL_INJECT_TOP_K=2

# 输出物 vault。控制台可改，改动写在 data/content_roots.json。
# 默认读本机 iCloud Obsidian 的 expe 库。
OUTPUTS_VAULT_ROOT="~/Library/Mobile Documents/iCloud~md~obsidian/Documents/expe"
# 额外只读根（逗号分隔的绝对路径），以文件夹名出现在一级目录
OUTPUTS_VAULT_EXTRA="/Users/expeqiu/Library/Mobile Documents/com~apple~CloudDocs/dashboard"

# 并发控制
MAX_CONCURRENT_TASKS=3
AGENT_SERIAL_EXECUTION=true

# System 页 Cron 修复派单目标（默认 ops-agent，可回退 ops/main）
OPS_REPAIR_AGENT_ID=ops-agent

# 多端协调器。云端、fleet-edge 与 ESP32 语音终端共用同一个注册令牌；留空则拒绝设备注册。
# 云端要对任意设备开放时，把 HOST 改成 0.0.0.0。
FLEET_ENROLL_TOKEN=
FLEET_HEARTBEAT_TTL=45
# 多端页「绑定到云端」的初始地址。只在尚未保存时生效；留空表示本机协调器。
FLEET_CLOUD_URL=
