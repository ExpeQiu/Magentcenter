# AgentCenter 配置

# 服务
HOST=127.0.0.1
PORT=8013
FRONTEND_PORT=3013
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./data/agentcenter.db

# 双运行时（逗号分隔）
RUNTIMES=openclaw,hermes
DEFAULT_RUNTIME=openclaw

# OpenClaw
OPENCLAW_EXECUTABLE=openclaw
OPENCLAW_MODE=local
OPENCLAW_GATEWAY_HOST=
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_DEFAULT_TIMEOUT=600
OPENCLAW_MIN_VERSION=2026.5.5

# Hermes
HERMES_EXECUTABLE=hermes
HERMES_HOME=
HERMES_DEFAULT_TIMEOUT=600

# Mock 模式（开发/测试时跳过真实 CLI 调用）
AI_MOCK_MODE=false

# 告警（可选；运行时也可经 /api/settings/alert 热更新，多环境见 alert_profiles.json）
FEISHU_WEBHOOK_URL=
CRON_ALERT_INTERVAL=300
CRON_ALERT_ENABLED=true
GATEWAY_ALERT_ENABLED=true
DISK_ALERT_THRESHOLD=90
ALERT_PROFILE=default

# 知识库向量：hash（默认）| openai | http（OpenAI 兼容 /v1/embeddings）
EMBEDDING_PROVIDER=hash
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# 任务前自动注入知识卡片；完成后蒸馏 Playbook/Precedent/Incident
KNOWLEDGE_INJECT_ENABLED=true
KNOWLEDGE_INJECT_TOP_K=3

# 技能目录
SKILLS_DIR=
HERMES_SKILLS_DIR=

# 输出物 vault（OpenClaw / Hermes 业务 Markdown 只读浏览）
OUTPUTS_VAULT_ROOT="/Users/expeqiu/Library/Mobile Documents/iCloud~md~obsidian/Documents/expe"

# 并发控制
MAX_CONCURRENT_TASKS=3
AGENT_SERIAL_EXECUTION=true

# System 页 Cron 修复派单目标（默认 ops-agent，可回退 ops/main）
OPS_REPAIR_AGENT_ID=ops-agent
